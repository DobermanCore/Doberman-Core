{
  "$defs": {
    "ResolvedPolicy": {
      "description": "The merged effective policy across all sources (immutable, raise-only).\n\n``blocked_globs`` and ``sensitive_globs`` are the unions across sources,\nwith ``blocked`` taking precedence (a glob blocked by any source is removed\nfrom ``sensitive``). ``contributors`` records ``(name, authority)`` per\nsource in ascending-authority order for audit/explainability.",
      "properties": {
        "blocked_globs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocked Globs",
          "type": "array"
        },
        "contributors": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Contributors",
          "type": "array"
        },
        "sensitive_globs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sensitive Globs",
          "type": "array"
        }
      },
      "title": "ResolvedPolicy",
      "type": "object"
    },
    "RoleSnapshot": {
      "description": "The verdict-relevant part of the active role (globs only, no description).",
      "properties": {
        "allowed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "blocked": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocked",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "suspicious": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suspicious",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "RoleSnapshot",
      "type": "object"
    }
  },
  "description": "The exact content a policy version identifies (immutable).\n\n``schema_version`` serialises as the JSON key ``schema`` (the field name\navoids shadowing ``BaseModel.schema``).",
  "properties": {
    "doc": {
      "additionalProperties": true,
      "title": "Doc",
      "type": "object"
    },
    "enforcement_effective": {
      "title": "Enforcement Effective",
      "type": "string"
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "resolved_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolvedPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoleSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "default": 1,
      "title": "Schema",
      "type": "integer"
    }
  },
  "required": [
    "engine",
    "enforcement_effective",
    "doc"
  ],
  "title": "PolicySnapshotV1",
  "type": "object"
}
